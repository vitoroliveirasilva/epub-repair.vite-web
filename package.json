{
  "name": "epub-repair.vite-web",
  "version": "2.0.0",
  "description": "Ferramenta front-end estática para validar, reparar e reempacotar EPUBs localmente no navegador com objetivo em aumentar a compatibilidade com fluxos de envio/upload para Kindle.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Vitor Oliveira",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}