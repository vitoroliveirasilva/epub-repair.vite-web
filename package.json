{
  "name": "epub-repair.vite-web",
  "version": "2.0.0",
  "description": "Ferramenta front-end estática para validar, reparar e reempacotar EPUBs localmente no navegador com objetivo em aumentar a compatibilidade com fluxos de envio/upload para Kindle.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Vitor Oliveira",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.7",
    "eslint": "^9.30.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}