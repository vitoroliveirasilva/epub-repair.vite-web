{
  "name": "epub-repair.vite-web",
  "version": "4.0.0",
  "description": "Ferramenta front-end estática para validar, reparar e reempacotar EPUBs localmente no navegador com objetivo em aumentar a compatibilidade com fluxos de envio/upload para Kindle.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Vitor Oliveira",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan:av": "node scripts/scan-epub-av.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^5.4.624",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.9.1",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
